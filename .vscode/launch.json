{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SGPT app",
      "type": "debugpy",
      "request": "launch",
      "module": "sgpt.app",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "SGPT command line (topic search)",
      "type": "debugpy",
      "request": "launch",
      "module": "sgpt",
      "args": ["--topic", "Photosynthesis", "--subject", "Biology", "--level", "GCSE", "--plan", "mcq:5,short:3"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "SGPT command line (match past papers in library/)",
      "type": "debugpy",
      "request": "launch",
      "module": "sgpt",
      "args": ["library", "--structure", "match"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
