{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Easy Exam app",
      "type": "debugpy",
      "request": "launch",
      "module": "easy_exam.app",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Easy Exam command line (topic search)",
      "type": "debugpy",
      "request": "launch",
      "module": "easy_exam",
      "args": ["--topic", "Photosynthesis", "--subject", "Biology", "--level", "GCSE", "--plan", "mcq:5,short:3"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Easy Exam command line (match past papers in library/)",
      "type": "debugpy",
      "request": "launch",
      "module": "easy_exam",
      "args": ["library", "--structure", "match"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
